{
  "actions_as_menu": true,
  "keybinds": {
    "show_actions": ["shift right", "tab"]
  },
  "providers": {
    "actions": {
      "clipboard": [
        { "action": "copy", "default": true, "bind": "Return" },
        { "action": "remove", "bind": "delete" },
        { "action": "remove_all", "bind": "shift delete" },
        { "action": "toggle_images", "bind": "alt i" },
        { "action": "edit", "bind": "alt e" }
      ],
      "files": [
        { "action": "open", "default": true, "bind": "Return" },
        { "action": "opendir", "bind": "alt Return" },
        { "action": "copypath", "bind": "shift Return" },
        { "action": "copyfile", "bind": "ctrl c" }
      ],
      "archlinuxpkgs": [
        { "action": "install", "default": true, "bind": "Return" },
        { "action": "remove", "bind": "shift Return" }
      ]
    }
  }
}
