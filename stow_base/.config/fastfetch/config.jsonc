{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/cachyos.png",
    "width": 24,
    "height": 12,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "\u001b[38;5;240m│\u001b[0m ",
    "color": {
      "keys": "white",
      "title": "green"
    },
    "percent": {
      "type": 9
    },
    "size": {
      "ndigits": 2
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;5;240m╭─────────────╮\u001b[0m"
    },
    {
      "type": "title",
      "key": "│ \u001b[38;5;111m󰀄\u001b[39m user      ",
      "format": "{user-name}"
    },
    {
      "type": "title",
      "key": "│ \u001b[38;5;111m󰌢\u001b[39m hname     ",
      "format": "{host-name}"
    },
    {
      "type": "uptime",
      "key": "│ \u001b[38;5;117m󰅐\u001b[39m uptime    "
    },
    {
      "type": "os",
      "key": "│ \u001b[38;5;43m󰣇\u001b[39m distro    "
    },
    {
      "type": "kernel",
      "key": "│ \u001b[38;5;208m󰌽\u001b[39m kernel    ",
      "format": "{sysname} {release}"
    },
    {
      "type": "wm",
      "key": "│ \u001b[38;5;141m󰘔\u001b[39m desktop   "
    },
    {
      "type": "terminal",
      "key": "│ \u001b[38;5;79m󰆍\u001b[39m term      "
    },
    {
      "type": "shell",
      "key": "│ \u001b[38;5;49m󱆃\u001b[39m shell     "
    },
    {
      "type": "cpu",
      "key": "│ \u001b[38;5;203m󰻠\u001b[39m cpu       "
    },
    {
      "type": "gpu",
      "key": "│ \u001b[38;5;77m󰢮\u001b[39m gpu       ",
      "detectionMethod": "pci",
      "format": "{name} [{type}]"
    },
    {
      "type": "disk",
      "key": "│ \u001b[38;5;221m󰋊\u001b[39m disk      ",
      "folders": "/"
    },
    {
      "type": "memory",
      "key": "│ \u001b[38;5;213m󰍛\u001b[39m memory    "
    },
    {
      "type": "colors",
      "key": "│ \u001b[38;5;176m󰏘\u001b[39m colors    ",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;240m╰─────────────╯\u001b[0m"
    }
  ]
}
